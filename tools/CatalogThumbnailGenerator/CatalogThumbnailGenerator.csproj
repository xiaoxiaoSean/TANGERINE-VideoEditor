<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reference an already-built editor so asset generation never launches a
         competing WPF/MSBuild build against the editor's shared obj directory. -->
    <EditorAssembly Condition="'$(EditorAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\TANGERINE-VideoEditor\bin\Debug\net10.0-windows\TANGERINE-VideoEditor.dll</EditorAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TANGERINE-VideoEditor" HintPath="$(EditorAssembly)" />
    <Reference Include="TANGERINE-VideoEditor.Automation" HintPath="$([System.IO.Path]::GetDirectoryName('$(EditorAssembly)'))\TANGERINE-VideoEditor.Automation.dll" />
    <Content Include="$(NuGetPackageRoot)ffmpeg.static/4.4.0.7/ffmpeg/**"
             Link="ffmpeg/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
