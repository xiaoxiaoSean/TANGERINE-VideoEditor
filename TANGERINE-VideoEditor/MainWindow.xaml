<Window x:Class="TANGERINE_VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TANGERINE_VideoEditor"
        Title="TANGERINE · 视频剪辑" WindowState="Maximized"
        Background="#101114" Foreground="White" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <local:ProportionalSizeConverter x:Key="ProportionalSize" />
        <DataTemplate x:Key="CatalogListTemplate">
            <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9B9EA7" FontSize="11" /></StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MediaListTemplate">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24*" /><ColumnDefinition Width="76*" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9B9EA7" FontSize="11" /></StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MediaThumbnailTemplate">
            <StackPanel><Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource ProportionalSize}, ConverterParameter=0.5625}" IsHitTestVisible="False" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="#9B9EA7" FontSize="11" />
            </StackPanel>
        </DataTemplate>
        <SolidColorBrush x:Key="Panel" Color="#191B20" />
        <SolidColorBrush x:Key="Surface" Color="#24262C" />
        <SolidColorBrush x:Key="Line" Color="#34363D" />
        <SolidColorBrush x:Key="Muted" Color="#9B9EA7" />
        <SolidColorBrush x:Key="Accent" Color="#FF9957" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#35373F" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#484B54" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Body" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#2C2E34" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#302C2B" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssetItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="10,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Body" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#393238" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="MenuItem"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" /></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#292B31" /><Setter Property="Foreground" Value="White" /><Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="Padding" Value="8,6" /></Style>
        <Style TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Foreground" Value="White" /></Style>
    </Window.Resources>
    <Grid x:Name="EditorRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="EditorMenuBar" Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem x:Name="NewMenuItem" Header="新建项目" InputGestureText="Ctrl+N" />
                <MenuItem x:Name="OpenMenuItem" Header="打开项目…" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem x:Name="SaveMenuItem" Header="保存项目" InputGestureText="Ctrl+S" />
                <MenuItem x:Name="SaveAsMenuItem" Header="项目另存为…" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem x:Name="ImportMenuItem" Header="导入媒体…" InputGestureText="Ctrl+I" />
                <MenuItem x:Name="ImportSrtMenuItem" Header="导入 SRT 字幕…" />
                <MenuItem x:Name="ExportMenuItem" Header="导出视频…" InputGestureText="Ctrl+E" />
                <MenuItem x:Name="ExportSrtMenuItem" Header="导出 SRT 字幕…" />
                <MenuItem x:Name="ExportFrameMenuItem" Header="导出当前帧…" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="退出" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem x:Name="UndoMenuItem" Header="撤销" InputGestureText="Ctrl+Z" />
                <MenuItem x:Name="RedoMenuItem" Header="重做" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem x:Name="CutMenuItem" Header="剪切" InputGestureText="Ctrl+X" />
                <MenuItem x:Name="CopyMenuItem" Header="复制" InputGestureText="Ctrl+C" />
                <MenuItem x:Name="PasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" />
                <MenuItem x:Name="DeleteMenuItem" Header="删除" InputGestureText="Delete" />
                <Separator />
                <MenuItem x:Name="PreferencesMenuItem" Header="偏好设置…" />
            </MenuItem>
            <MenuItem Header="剪辑(_C)">
                <MenuItem x:Name="SplitMenuItem" Header="在播放头处分割" InputGestureText="Ctrl+B" />
                <MenuItem x:Name="RippleDeleteMenuItem" Header="波纹删除" />
                <MenuItem x:Name="DuplicateMenuItem" Header="复制片段" />
                <MenuItem x:Name="GroupMenuItem" Header="编组" />
                <MenuItem x:Name="UngroupMenuItem" Header="取消编组" />
                <MenuItem x:Name="LinkMenuItem" Header="链接音视频" />
                <MenuItem x:Name="UnlinkMenuItem" Header="解除链接" />
                <Separator />
                <MenuItem x:Name="EffectControlsMenuItem" Header="效果控件…" />
                <MenuItem x:Name="AudioClipPropertiesMenuItem" Header="音频属性…" />
                <MenuItem x:Name="AddSubtitleMenuItem" Header="在播放头添加字幕" />
                <MenuItem x:Name="SubtitleEditorMenuItem" Header="字幕编辑器…" />
                <MenuItem x:Name="PaperEditMenuItem" Header="基于文本的剪辑…" />
                <MenuItem x:Name="SpeedRampMenuItem" Header="时间重映射…" />
                <MenuItem x:Name="SaveGraphicTemplateMenuItem" Header="保存所选图形模板…" />
                <MenuItem x:Name="InsertGraphicTemplateMenuItem" Header="插入图形模板…" />
            </MenuItem>
            <MenuItem Header="轨道(_T)">
                <MenuItem x:Name="AddVideoTrackMenuItem" Header="添加视频轨道" />
                <MenuItem x:Name="AddAudioTrackMenuItem" Header="添加音频轨道" />
                <MenuItem x:Name="RenameTrackMenuItem" Header="重命名当前轨道…" />
                <MenuItem x:Name="DeleteTrackMenuItem" Header="删除当前轨道" />
                <MenuItem x:Name="DeleteEmptyTracksMenuItem" Header="删除所有空轨道" />
                <Separator />
                <MenuItem x:Name="MoveTrackUpMenuItem" Header="当前轨道上移" />
                <MenuItem x:Name="MoveTrackDownMenuItem" Header="当前轨道下移" />
                <MenuItem x:Name="FitTimelineMenuItem" Header="适配时间线" />
                <Separator />
                <MenuItem x:Name="VoiceOverMenuItem" Header="录制画外音…" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem x:Name="ZoomInMenuItem" Header="放大时间线" />
                <MenuItem x:Name="ZoomOutMenuItem" Header="缩小时间线" />
                <MenuItem x:Name="ResetWorkspaceMenuItem" Header="重置工作区" />
                <MenuItem Header="工作区">
                    <MenuItem x:Name="EditingWorkspaceMenuItem" Header="剪辑工作区" />
                    <MenuItem x:Name="ColorWorkspaceMenuItem" Header="调色工作区" />
                    <MenuItem x:Name="AudioWorkspaceMenuItem" Header="音频工作区" />
                    <Separator />
                    <MenuItem x:Name="SaveWorkspaceMenuItem" Header="保存当前工作区布局" />
                    <MenuItem x:Name="RestoreWorkspaceMenuItem" Header="恢复保存的布局" />
                </MenuItem>
                <MenuItem x:Name="ColorScopesMenuItem" Header="视频示波器…" />
                <MenuItem x:Name="AudioMixerMenuItem" Header="音轨混音器…" />
            </MenuItem>
            <MenuItem Header="为系统做设置">
                <MenuItem x:Name="DefaultOpenWithMenuItem" Header="默认打开方式设置…" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem x:Name="McpConnectionMenuItem" Header="AI / MCP 连接…" />
                <MenuItem x:Name="ShortcutsMenuItem" Header="快捷键" />
                <MenuItem x:Name="AboutMenuItem" Header="关于 TANGERINE" />
            </MenuItem>
        </Menu>
        <TextBlock x:Name="McpControlNotice" Grid.Row="0" Text="正在通过MCP操作本程序"
                   Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"
                   Background="{StaticResource Panel}" Foreground="{StaticResource Accent}"
                   Padding="10,5" FontWeight="SemiBold" />
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TANGERINE" Foreground="{StaticResource Accent}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,16,0" />
                    <Button x:Name="NewProjectButton" Content="＋ 新建" Style="{StaticResource ToolButton}" />
                    <Button x:Name="OpenProjectButton" Content="▣ 打开" Style="{StaticResource ToolButton}" />
                    <Button x:Name="SaveProjectButton" Content="▤ 保存" Style="{StaticResource ToolButton}" />
                    <Button x:Name="ImportMediaButton" Content="＋ 导入媒体" Style="{StaticResource ToolButton}" Margin="16,0,0,0" />
                    <Button x:Name="UndoButton" Content="↶ 撤销" Style="{StaticResource ToolButton}" />
                    <Button x:Name="RedoButton" Content="↷ 重做" Style="{StaticResource ToolButton}" />
                </StackPanel>
                <Button x:Name="ExportButton" Content="导出视频  ↗" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Background="{StaticResource Accent}" Foreground="#17120E" FontWeight="SemiBold" Padding="19,7" />
                <TextBlock x:Name="ProjectNameText" Text="未命名项目.tvep" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Grid x:Name="EditorAreaGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="UpperWorkspaceRow" Height="56*" MinHeight="{Binding ActualHeight, ElementName=EditorAreaGrid, Converter={StaticResource ProportionalSize}, ConverterParameter=0.15}" />
                <RowDefinition Height="1*" />
                <RowDefinition x:Name="TimelineWorkspaceRow" Height="44*" MinHeight="{Binding ActualHeight, ElementName=EditorAreaGrid, Converter={StaticResource ProportionalSize}, ConverterParameter=0.15}" />
            </Grid.RowDefinitions>
            <!-- Object library and player share the upper work area. -->
            <Grid x:Name="UpperWorkspaceGrid" Grid.Row="0" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LibraryWorkspaceColumn" Width="44*" MinWidth="{Binding ActualWidth, ElementName=UpperWorkspaceGrid, Converter={StaticResource ProportionalSize}, ConverterParameter=0.15}" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition x:Name="PreviewWorkspaceColumn" Width="56*" MinWidth="{Binding ActualWidth, ElementName=UpperWorkspaceGrid, Converter={StaticResource ProportionalSize}, ConverterParameter=0.15}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,4,0">
                    <Grid x:Name="LibraryDropSurface" AllowDrop="True">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="21*" /><ColumnDefinition Width="79*" /></Grid.ColumnDefinitions>
                        <ListBox x:Name="CategoryList" Grid.Column="0" ItemContainerStyle="{StaticResource CategoryItem}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" />
                        <Grid x:Name="LibraryContentGrid" Grid.Column="1" Margin="13,11,13,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,9">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock x:Name="LibraryTitle" Text="媒体" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LibrarySubtitle" Text="导入素材，拖入时间线开始创作" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="LibraryAddButton" Content="＋ 添加" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ToolButton}" />
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70*" /><ColumnDefinition Width="30*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="AssetSearchBox" ToolTip="搜索媒体、文字、效果和转场" />
                                <ComboBox x:Name="MediaViewBox" Grid.Column="1" Margin="5,0,0,0" ToolTip="媒体显示方式" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="AssetList" ItemContainerStyle="{StaticResource AssetItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock x:Name="EmptyLibraryMessage" Text="从上方添加媒体，或从左侧选择内置素材" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                        <ContentControl x:Name="SettingsHost" Grid.Column="1" Margin="13,11,13,10"
                                        Visibility="Collapsed" Panel.ZIndex="5" />
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#34363D" ShowsPreview="True" ToolTip="拖动调整媒体区与预览区比例" />
                <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="4,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="15,10" LastChildFill="False">
                            <TextBlock Text="预览器" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <ComboBox x:Name="PreviewQualityBox" DockPanel.Dock="Right"
                                      ToolTip="选择预览解码分辨率" VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <ComboBox x:Name="AspectRatioBox" DockPanel.Dock="Right"
                                      ToolTip="选择项目预览宽高比" VerticalAlignment="Center"
                                      Margin="0,0,8,0" MinWidth="80" />
                            <Button x:Name="PreviewCropButton" Content="裁切" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0,0,8,0" ToolTip="选择图片或视频后，拖动青色控制点裁切四边" />
                        </DockPanel>
                        <Border x:Name="PreviewViewport" Grid.Row="1" Background="#070809" Margin="15,0" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="PreviewStage" RenderTransformOrigin="0.5,0.5">
                                <Canvas x:Name="PreviewVisualLayer" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
                                    <MediaElement x:Name="PreviewMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Fill" Visibility="Collapsed" />
                                    <Image x:Name="PreviewImage" Stretch="Fill" Visibility="Collapsed" />
                                    <Image x:Name="PreviewRenderedFrame" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
                                </Canvas>
                                <Canvas x:Name="PreviewOverlay" Background="Transparent" ClipToBounds="True" />
                                </Grid>
                                <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="▶" Foreground="#444850" FontSize="46" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PreviewMessage" Text="预览将在这里显示" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    <ProgressBar x:Name="CatalogPreviewProgressBar" Width="260" Height="7" Margin="0,10,0,0"
                                                 Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="CatalogPlaybackBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="12,0,12,10" Padding="8,4" Background="#E0181A1F" BorderBrush="#778087" BorderThickness="1"
                                        CornerRadius="5" Panel.ZIndex="30">
                                    <DockPanel LastChildFill="True" MinWidth="360">
                                        <Button x:Name="CatalogPlaybackButton" Content="❚❚" Width="32" Height="25" Padding="0"
                                                Style="{StaticResource ToolButton}" DockPanel.Dock="Left" ToolTip="播放 / 暂停示例视频" />
                                        <TextBlock x:Name="CatalogPlaybackTime" Text="00:00 / 00:00" Foreground="White" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="8,0,8,0" DockPanel.Dock="Right" />
                                        <Slider x:Name="CatalogPlaybackSlider" Minimum="0" Maximum="1" Value="0" Height="22"
                                                VerticalAlignment="Center" ToolTip="拖动查看示例视频" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="15,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18*" /><ColumnDefinition Width="64*" /><ColumnDefinition Width="18*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewZoomText" Text="视图 100%" VerticalAlignment="Center" />
                            <Slider x:Name="PreviewZoomSlider" Grid.Column="1" Minimum="0.1" Maximum="4" Value="1" SmallChange="0.1" LargeChange="0.25" IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="预览视图缩放 · Ctrl+滚轮" />
                            <Button x:Name="PreviewZoomResetButton" Grid.Column="2" Content="回位" Style="{StaticResource ToolButton}" ToolTip="恢复适配窗口（100%）" />
                        </Grid>
                        <Grid Grid.Row="3" Margin="15,7,15,11">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="33*" /><ColumnDefinition Width="34*" /><ColumnDefinition Width="33*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="00:00:00:00" Foreground="{StaticResource Accent}" FontFamily="Consolas" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BackButton" Content="⏮" Style="{StaticResource ToolButton}" ToolTip="上一帧" />
                                <Button x:Name="PlayPauseButton" Content="▶" Style="{StaticResource ToolButton}" ToolTip="播放 / 暂停" />
                                <Button x:Name="StopButton" Content="■" Style="{StaticResource ToolButton}" ToolTip="停止" />
                                <Button x:Name="ForwardButton" Content="⏭" Style="{StaticResource ToolButton}" ToolTip="下一帧" />
                            </StackPanel>
                            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00:00:00" Foreground="{StaticResource Muted}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="#34363D" ShowsPreview="True" />
            <!-- The scroll viewer exposes both scrollbars and supports wheel and touch panning. -->
            <Border Grid.Row="2" Margin="8,4,8,8" Background="{StaticResource Panel}" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65*" /><ColumnDefinition Width="35*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="时间线" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,19,0" />
                            <Button x:Name="AddTrackButton" Content="＋ 轨道" Style="{StaticResource ToolButton}" />
                            <Button x:Name="SplitButton" Content="✂ 分割" Style="{StaticResource ToolButton}" />
                            <Button x:Name="DeleteButton" Content="▤ 删除" Style="{StaticResource ToolButton}" />
                            <Button x:Name="PropertiesButton" Content="⚙ 属性" Style="{StaticResource ToolButton}" ToolTip="编辑选中片段属性；文字片段包含字体、描边和阴影" />
                            <Button x:Name="MagneticButton" Content="磁性：关" Style="{StaticResource ToolButton}" ToolTip="持续闭合空隙；锁定轨道与跨轨关联对象保留位置" />
                            <Button x:Name="SnapButton" Content="⊞ 吸附" Style="{StaticResource ToolButton}" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="－" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Slider x:Name="TimelineZoomSlider" Grid.Column="1" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.1" LargeChange="0.5" Margin="7,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="＋" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="8,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="30*" /><ColumnDefinition Width="5*" /><ColumnDefinition Width="30*" /><ColumnDefinition Width="20*" /><ColumnDefinition Width="10*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="L" /><ProgressBar x:Name="MeterLeft" Grid.Column="1" Maximum="60" Foreground="#54C6A8" Background="#282B32" ToolTip="实际混音左声道 -60 至 0 dBFS" />
                        <TextBlock Text="R" Grid.Column="2" HorizontalAlignment="Center" /><ProgressBar x:Name="MeterRight" Grid.Column="3" Maximum="60" Foreground="#54C6A8" Background="#282B32" ToolTip="实际混音右声道 -60 至 0 dBFS" />
                        <TextBlock x:Name="MeterPeakText" Grid.Column="4" FontSize="10" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" Text="峰 L -60 / R -60 dBFS" />
                        <Button x:Name="MeterResetButton" Grid.Column="5" Content="电平复位" Style="{StaticResource ToolButton}" Padding="2,0" />
                    </Grid>
                    <!-- The drag block floats above the scrolling canvas so it
                         tracks the pointer instead of the scroll offset. -->
                    <Canvas x:Name="TrackDragOverlay" Grid.Row="1" Background="Transparent"
                            IsHitTestVisible="False" Panel.ZIndex="20" ClipToBounds="True" />
                    <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1" Background="#111318" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" CanContentScroll="False" PanningMode="Both" Focusable="True">
                        <Canvas x:Name="TimelineCanvas" Background="#111318" AllowDrop="True">
                            <Canvas.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="TimelinePasteMenuItem" Header="粘贴片段" />
                                    <MenuItem x:Name="TimelineAddTrackMenuItem" Header="添加轨道" />
                                    <Separator />
                                    <MenuItem x:Name="TimelineSplitContextItem" Header="在播放头处分割" />
                                    <MenuItem x:Name="TimelineRippleDeleteItem" Header="波纹删除" />
                                    <MenuItem x:Name="TimelineDuplicateItem" Header="复制片段" />
                                    <Separator />
                                    <MenuItem x:Name="TimelineSpeedItem" Header="速度 / 时长…" />
                                    <MenuItem x:Name="TimelineReverseItem" Header="反向播放" />
                                    <MenuItem x:Name="TimelineFreezeItem" Header="冻结帧" />
                                    <MenuItem x:Name="TimelineKeyframeItem" Header="添加关键帧" />
                                    <Separator />
                                    <MenuItem x:Name="TimelineLockTrackItem" Header="锁定 / 解锁轨道" />
                                    <MenuItem x:Name="TimelineRenameTrackItem" Header="重命名轨道…" />
                                    <MenuItem x:Name="TimelineMuteTrackItem" Header="静音 / 取消静音轨道" />
                                    <MenuItem x:Name="TimelineHideTrackItem" Header="隐藏 / 显示轨道" />
                                    <MenuItem x:Name="TimelineMoveTrackUpItem" Header="轨道上移" />
                                    <MenuItem x:Name="TimelineMoveTrackDownItem" Header="轨道下移" />
                                    <MenuItem x:Name="TimelineRemoveTrackItem" Header="删除轨道" />
                                    <MenuItem x:Name="TimelineRemoveEmptyTracksItem" Header="删除所有空轨道" />
                                    <Separator />
                                    <MenuItem x:Name="TimelineZoomFitItem" Header="适配时间线" />
                                </ContextMenu>
                            </Canvas.ContextMenu>
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="11,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource Muted}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="12,0" />
                    <TextBlock x:Name="ProjectAspectRatioText" Text="宽高比 16:9" Foreground="{StaticResource Muted}" Margin="12,0" />
                    <TextBlock x:Name="SaveStateText" Text="已保存" Foreground="{StaticResource Muted}" Margin="12,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
