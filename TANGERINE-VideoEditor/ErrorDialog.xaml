<Window x:Class="TANGERINE_VideoEditor.ErrorDialogWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0F0F0F" Foreground="#F8FAFC"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner"
        MinWidth="420" MinHeight="280">
    <DockPanel Margin="18">
        <Button x:Name="closeButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                Margin="0,14,0,0" Click="Close_Click"
                Padding="24,8" Background="#1E293B" Foreground="#F8FAFC"
                BorderBrush="#334155" BorderThickness="1" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="diagnosticText" Margin="4" TextWrapping="Wrap"
                       Foreground="#F8FAFC" LineHeight="22" />
        </ScrollViewer>
    </DockPanel>
</Window>
